<Window x:Class="PinToDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PinToDesk.Models"
        Title="PinToDesk_edit" Width="280"
        MinWidth="280" MinHeight="364" ShowActivated="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize" PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated">

    <!-- 主容器：圆角边框 + 动态主题磨砂背景 -->
    <Border x:Name="RootBorder"
            Style="{StaticResource FluentWindowBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 标题栏：拖动 + TitleBar 按钮组
            ══════════════════════════════════════════ -->
            <Grid Grid.Row="0" x:Name="TitleBar"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseEnter="TitleBar_MouseEnter"
                  MouseLeave="TitleBar_MouseLeave"
                  Background="Transparent">

                <TextBlock Text="TodoList"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>

                <!-- 右侧按钮组：新建 | 隐藏 -->
                <StackPanel x:Name="TitleButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,8,0">

                    <Button x:Name="AddBtn"
                            Content="＋" ToolTip="新建待办"
                            Style="{StaticResource TitleBarBtn}"
                            Width="26" Height="26"
                            Margin="2,0"
                            Click="AddBtn_Click"/>

                    <Button x:Name="CloseBtn"
                            Content="✕" ToolTip="隐藏便签"
                            Style="{StaticResource TitleBarBtn}"
                            Width="26" Height="26"
                            Margin="2,0"
                            Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeSeparatorBrush}" BorderThickness="0,0,0,1"
                    Margin="10,0,10,4" Padding="0,0,0,3" Background="Transparent"
                    PreviewMouseWheel="TabBar_MouseWheel">
                <DockPanel>
                    <Button x:Name="NewGroupButton" Opacity="1" FontSize="16" DockPanel.Dock="Right" Width="26" Height="26"
                            Margin="4,0,0,0" Style="{StaticResource TitleBarBtn}" Content="＋"
                            ToolTip="新建标签" AutomationProperties.Name="新建标签" Click="NewGroup_Click"/>
                    <ListBox x:Name="GroupTabs" SelectionChanged="GroupTabs_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Focusable="False">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,3,0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TabFace" Background="Transparent" CornerRadius="5,5,2,2">
                                                <Grid>
                                                    <ContentPresenter/>
                                                    <Border x:Name="Underline" Height="2" Margin="9,0" VerticalAlignment="Bottom"
                                                            Background="{DynamicResource ThemeTabAccentBrush}" Visibility="Hidden"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource ThemeItemHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource ThemeItemSelectedBrush}"/>
                                                    <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" MinWidth="48" MaxWidth="150" Height="28"
                                      PreviewMouseLeftButtonDown="Tab_MouseDown">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="删除标签…" Click="DeleteGroup_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock x:Name="TabNameLabel" Text="{Binding Name}" ToolTip="{Binding Name}" Margin="10,0"
                                               VerticalAlignment="Center" TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="NameBox" Visibility="Collapsed" MinWidth="82" Margin="1"
                                             Style="{StaticResource TabNameInput}" MaxLength="64"
                                             PreviewKeyDown="TabName_KeyDown" LostKeyboardFocus="TabName_LostFocus"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="NameBox" Property="Visibility" Value="Visible">
                                        <Setter TargetName="TabNameLabel" Property="Visibility" Value="Hidden"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 内容区：列表 + ResizeGrip
            ══════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="19"/>
                </Grid.RowDefinitions>

                <!-- 待办列表 + 空列表占位符（同一 Grid 单元格叠放） -->
                <Grid Grid.Row="0" ClipToBounds="True">
                    <ListView x:Name="TodoList"
                              ClipToBounds="True"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="False"
                              RenderOptions.ClearTypeHint="Enabled"
                              TextOptions.TextFormattingMode="Display"
                              FocusVisualStyle="{x:Null}"
                              IsTabStop="False"
                              MouseDoubleClick="TodoList_MouseDoubleClick"
                              PreviewMouseLeftButtonDown="TodoList_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="TodoList_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="TodoList_PreviewMouseLeftButtonUp">

                        <!-- 使用自定义 ScrollViewer（细滚动条，自动隐藏） -->
                        <ListView.Template>
                            <ControlTemplate TargetType="ListView">
                                <ScrollViewer x:Name="PART_ScrollViewer"
                                              Style="{StaticResource NarrowScrollViewer}"
                                              CanContentScroll="False"
                                              Focusable="False"
                                              ClipToBounds="True">
                                    <ItemsPresenter ClipToBounds="True"/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListView.Template>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <EventSetter Event="PreviewMouseRightButtonUp" Handler="TodoItem_RightButtonUp"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="itemBd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Margin="6,2">
                                                <Border x:Name="HoverLayer" CornerRadius="6" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverLayer" Property="Background" Value="{DynamicResource ThemeItemHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DisplayColor}" Value="{x:Static local:TodoColor.Rose}">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static local:TodoColor.Rose}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayColor}" Value="{x:Static local:TodoColor.Apricot}">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static local:TodoColor.Apricot}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayColor}" Value="{x:Static local:TodoColor.Honey}">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static local:TodoColor.Honey}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayColor}" Value="{x:Static local:TodoColor.Sage}">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static local:TodoColor.Sage}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayColor}" Value="{x:Static local:TodoColor.Aqua}">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static local:TodoColor.Aqua}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayColor}" Value="{x:Static local:TodoColor.Sky}">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static local:TodoColor.Sky}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayColor}" Value="{x:Static local:TodoColor.Lilac}">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static local:TodoColor.Lilac}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TodoItem}">
                                <Grid Margin="8,5" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧圆点标识，对齐首行 -->
                                    <Ellipse Grid.Column="0"
                                             Width="6" Height="6"
                                             Fill="{DynamicResource ThemeTextTertiaryBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,6,8,0"/>

                                    <!-- 待办文本：自动换行，占满全部宽度，动态折叠/展开 -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Style="{DynamicResource TodoItemTextBlockStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 空列表占位符 -->
                    <TextBlock x:Name="EmptyPlaceholder"
                               Text="暂无待办"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPlaceholderBrush}"
                               FontSize="13"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                </Grid>

                <!-- 右下角自定义 ResizeGrip -->
                <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Border x:Name="ResizeGripArea"
                            Width="24" Height="17" ToolTip="拖动调整大小"
                            Background="Transparent"
                            Cursor="SizeNWSE"
                            Margin="0,0,6,3">
                        <Canvas Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Line X1="9" Y1="1" X2="1" Y2="9" Stroke="{DynamicResource ThemeTextTertiaryBrush}" StrokeThickness="1.2" StrokeEndLineCap="Round"/>
                            <Line X1="9" Y1="5" X2="5" Y2="9" Stroke="{DynamicResource ThemeTextTertiaryBrush}" StrokeThickness="1.2" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
