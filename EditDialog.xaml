<Window x:Class="PinToDesk.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PinToDesk.Models"
        Title="编辑待办"
        Width="240"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">

    <!-- 与主窗口一致：圆角 + 动态半透明磨砂背景 -->
    <Border Style="{StaticResource FluentWindowBorder}">
        <StackPanel Margin="14,12">

            <!-- 标题行：可拖动 -->
            <Grid x:Name="DlgTitleBar"
                  MouseLeftButtonDown="DlgTitleBar_MouseLeftButtonDown"
                  Margin="0,0,0,10">
                <TextBlock x:Name="DlgTitleText"
                           Text="编辑待办"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 输入框：使用与主窗口一致的样式 -->
            <TextBox x:Name="InputBox"
                     Style="{StaticResource InlineTextBox}"
                     Margin="0,0,0,12"
                     PreviewKeyDown="InputBox_PreviewKeyDown"
                     TextChanged="InputBox_TextChanged"/>
            <Grid x:Name="DialogActions">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Visibility="Collapsed" Content="删除" Width="48" Height="28"
                        HorizontalAlignment="Left" Style="{StaticResource FluentPrimaryButton}"
                        Background="#B13749" Foreground="White" Click="Delete_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Background" Value="#C23D50"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fill" Property="Background" Value="#962D3E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="1" Content="取消" Width="52" Height="28" IsCancel="True"
                        Style="{StaticResource FluentSecondaryButton}" Focusable="True" IsTabStop="True"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Grid.Column="2" Content="确认" Width="72" Margin="8,0,0,0"
                        Style="{StaticResource FluentPrimaryButton}" Click="Confirm_Click"/>
                <ListBox x:Name="ColorBar" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                         AutomationProperties.Name="待办颜色" SelectedValuePath="Value"
                         SelectionChanged="ColorBar_SelectionChanged">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="8"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent" Height="26">
                                            <Border x:Name="Ring" Width="24" Height="24" BorderThickness="1.5" CornerRadius="5"/>
                                            <Border Width="17" Height="17" Background="{Binding Chip}" CornerRadius="3"
                                                    BorderBrush="#30000000" BorderThickness="1">
                                                <Border x:Name="ChipShade" CornerRadius="2" Background="{DynamicResource ThemeSwatchShadeBrush}">
                                                    <Path x:Name="Slash" Data="M 0,10 L 10,0" Stroke="#6B6B6B" StrokeThickness="1.5"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Border>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:TodoColor.None}">
                                                <Setter TargetName="ChipShade" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ThemeTextTertiaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </StackPanel>
    </Border>
</Window>
