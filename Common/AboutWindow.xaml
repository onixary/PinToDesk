<Window x:Class="PinToDesk.Common.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 PinToDesk_edit" Width="324" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTabAccentBrush}"/>
            <Setter Property="ToolTip" Value="{Binding NavigateUri, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource FluentWindowBorder}"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="20,18,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 应用名 & 版本 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="PinToDesk_edit" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
            </DockPanel>

            <!-- 信息表格 -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="13"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="原作者：" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="li5bo5" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Text="修改优化：" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="onixary" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                <Border Grid.Row="2" Grid.ColumnSpan="3" Height="1" Margin="0,0,0,8" Background="{DynamicResource ThemeSeparatorBrush}"/>
                <TextBlock Grid.Row="3" Text="原项目地址" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12"/>
                <TextBlock Grid.Row="3" Grid.Column="2"><Hyperlink x:Name="OriginalRepository" NavigateUri="https://github.com/li5bo5/PinToDesk" RequestNavigate="OpenRepository">li5bo5/PinToDesk</Hyperlink></TextBlock>
                <TextBlock Grid.Row="4" Text="改版项目地址" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12"/>
                <TextBlock Grid.Row="4" Grid.Column="2"><Hyperlink x:Name="EditedRepository" NavigateUri="https://github.com/onixary/PinToDesk" RequestNavigate="OpenRepository">onixary/PinToDesk</Hyperlink></TextBlock>
            </Grid>

            <!-- 底部：版权与提示 -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <TextBlock Text="© 2026 li5bo5. All Rights Reserved.  ·  AGPL-3.0"
                           HorizontalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                <TextBlock Text="按 Esc 键或点击外部关闭"
                           HorizontalAlignment="Center"
                           FontSize="9"
                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
